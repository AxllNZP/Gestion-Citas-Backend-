# =============================================================
# .env.example — Plantilla de variables de entorno (medibook)
# -------------------------------------------------------------
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Completa cada valor con tus credenciales reales
#   3. NUNCA subas el archivo .env a git
#   4. Este archivo (.env.example) SI puede subirse a git
# =============================================================

# ============================================
# SERVIDOR
# ============================================
PORT=8080

# ============================================
# BASE DE DATOS
# ============================================
DB_HOST=localhost
DB_PORT=5433
DB_NAME=medibook_db
DB_USER=tu_usuario_postgres
DB_PASSWORD=tu_contraseña_postgres

# ============================================
# JWT
# ============================================
# Genera una clave segura en PowerShell:
# [Convert]::ToBase64String((1..64 | ForEach-Object { [byte](Get-Random -Max 256) }))
JWT_SECRET=genera_una_clave_segura_minimo_64_caracteres
JWT_EXPIRATION=86400000

# ============================================
# MAILTRAP - Email de pruebas
# Obtén tus credenciales en: mailtrap.io -> Inboxes -> SMTP Settings
# Y el token en: mailtrap.io -> API Tokens
# ============================================
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=465
MAIL_USER=tu_usuario_mailtrap
MAIL_PASS=tu_password_mailtrap
MAILTRAP_API_TOKEN=tu_api_token_mailtrap
MAILTRAP_INBOX_ID=tu_inbox_id_mailtrap
